# ================================================================
# LOCC (그리스도사랑교회) 환경변수 설정
# ================================================================
# 사용법: 이 파일을 .env 로 복사 후 값 입력
#   cp .env.example .env
#
# ⚠️  .env 파일은 절대 git에 커밋하지 마세요 (.gitignore 확인)
# ================================================================


# ================================================================
# 공통 필수 설정 (로컬/운영 모두 필요)
# ================================================================

# 스프링 프로파일: local | prod
SPRING_PROFILES_ACTIVE=local


# ── 데이터베이스 ─────────────────────────────────────────────────
# 로컬: jdbc:mariadb://localhost:3306/locc
# Docker: docker-compose가 자동으로 jdbc:mariadb://db:3306/${DB_NAME} 으로 설정
DB_URL=jdbc:mariadb://localhost:3306/locc
DB_NAME=locc
DB_USERNAME=locc_user
DB_PASSWORD=
DB_ROOT_PASSWORD=          # Docker Compose 전용 (MariaDB root 비밀번호)

# 커넥션 풀 (선택)
DB_POOL_SIZE=5
DB_POOL_MIN=2

# ── JPA ─────────────────────────────────────────────────────────
# update: 스키마 자동 변경 (개발 전용)
# validate: 검증만 (운영 필수)
JPA_DDL_AUTO=update


# ── JWT ─────────────────────────────────────────────────────────
# ⚠️ 반드시 암호학적으로 안전한 랜덤값 사용 (최소 512비트)
# 생성: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_BASE64_STRING
JWT_EXPIRATION=18000000       # 5시간 (밀리초)
JWT_REFRESH_EXPIRATION=604800000  # 7일 (밀리초)


# ── Redis ────────────────────────────────────────────────────────
# 로컬: localhost / Docker: redis (서비스명 자동 설정)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=              # ⚠️ 운영 환경에서는 반드시 설정


# ── 이메일 (Gmail SMTP) ───────────────────────────────────────────
# 앱 비밀번호 생성: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password


# ── OAuth2 소셜 로그인 ────────────────────────────────────────────
# Kakao: https://developers.kakao.com
KAKAO_CLIENT_ID=
# 로컬: http://localhost:3000/login/oauth2/code/kakao
# 운영: docker-compose가 APP_DOMAIN 기반으로 자동 설정
KAKAO_REDIRECT_URI=http://localhost:3000/login/oauth2/code/kakao

# Naver: https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:3000/login/oauth2/code/naver


# ── 외부 API 키 ───────────────────────────────────────────────────
KAKAO_MAP_API_KEY=           # https://developers.kakao.com
YOUTUBE_API_KEY=             # https://console.cloud.google.com


# ── 앱 URL / CORS ────────────────────────────────────────────────
# 로컬 개발 (프론트 3000, 백 8080 분리)
APP_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000
APP_OAUTH2_REDIRECT_URL=http://localhost:3000/oauth2/callback
APP_CORS_ORIGIN_1=http://localhost:3000
APP_CORS_ORIGIN_2=http://localhost:8080

# 쿠키 Secure 플래그: 로컬=false, 운영(HTTPS)=true
APP_COOKIE_SECURE=false


# ── 파일 업로드 ──────────────────────────────────────────────────
# 로컬: 상대경로 또는 절대경로
# Docker: docker-compose가 /app/uploads 로 자동 설정
FILE_UPLOAD_DIR=uploads
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=100MB


# ── 로깅 ─────────────────────────────────────────────────────────
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=DEBUG
LOG_FILE_NAME=logs/application.log
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_MAX_HISTORY=30


# ================================================================
# 운영(prod) 전용 추가 설정
# ================================================================
# docker-compose up 으로 배포할 때 아래 항목을 .env 에 추가하세요

# 실제 서비스 도메인 (https:// 포함)
# 이 값 하나로 OAuth2 콜백 URL, CORS 등이 자동 구성됩니다
# APP_DOMAIN=https://example.com

# 서버 포트 (기본 8080)
# SERVER_PORT=8080
