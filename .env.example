# ================================
# LOCC (그리스도사랑교회) 환경 변수 설정
# ================================
# 사용법: 이 파일을 .env로 복사하고 값을 변경하세요
# cp .env.example .env
# ================================

# ================================
# 스프링 프로파일 (local/prod)
# ================================
# local: 로컬 개발 환경
# prod: 운영 환경
SPRING_PROFILES_ACTIVE=local

# ================================
# 데이터베이스 설정
# ================================
DB_URL=jdbc:mariadb://localhost:3306/locc
DB_USERNAME=loccuser
DB_PASSWORD=loccpassword

# 커넥션 풀 설정
DB_POOL_SIZE=5
DB_POOL_MIN=2

# ================================
# JPA 설정
# ================================
# update: 엔티티 변경 시 스키마 자동 업데이트 (개발)
# validate: 스키마 검증만 수행 (운영 권장)
JPA_DDL_AUTO=update

# ================================
# JWT 설정
# ================================
# ⚠️ 운영에서는 반드시 변경하세요! (최소 256비트)
JWT_SECRET=your-secret-key-change-this-in-production-minimum-256-bits
# 5시간 (밀리초)
JWT_EXPIRATION=18000000
# 7일 (밀리초)
JWT_REFRESH_EXPIRATION=604800000

# ================================
# Redis 설정
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ================================
# 이메일 설정 (Gmail SMTP)
# ================================
# Gmail 앱 비밀번호 생성: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ================================
# OAuth2 소셜 로그인
# ================================
# Kakao Developers: https://developers.kakao.com
KAKAO_CLIENT_ID=your-kakao-client-id

# Naver Developers: https://developers.naver.com
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ================================
# 외부 API 키
# ================================
# Kakao Map API: https://developers.kakao.com
KAKAO_MAP_API_KEY=your-kakao-map-api-key

# YouTube Data API v3: https://console.cloud.google.com
YOUTUBE_API_KEY=your-youtube-api-key

# ================================
# 애플리케이션 설정
# ================================
# 애플리케이션 URL (OAuth 리다이렉트 등에 사용)
APP_URL=http://localhost:8080
SERVER_PORT=8080

# ================================
# 파일 업로드 설정
# ================================
# local: 프로젝트 내 uploads 폴더 또는 절대경로
# prod: /var/uploads/locc 등 절대경로 권장
FILE_UPLOAD_DIR=uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=50MB

# ================================
# Thymeleaf 템플릿 캐시
# ================================
# local: false (개발 시 즉시 반영)
# prod: true (성능 향상)
THYMELEAF_CACHE=false

# ================================
# 에러 처리 설정
# ================================
# local: always (개발 시 상세 정보 표시)
# prod: never (보안을 위해 숨김)
ERROR_INCLUDE_MESSAGE=always
ERROR_INCLUDE_STACKTRACE=always

# ================================
# 로깅 설정
# ================================
# 로그 레벨: TRACE, DEBUG, INFO, WARN, ERROR
# local: DEBUG/INFO
# prod: WARN/INFO
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=DEBUG

# 로그 파일 설정
# local: logs/application.log (프로젝트 내)
# prod: /var/log/locc/application.log (시스템 로그)
LOG_FILE_NAME=logs/application.log
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_MAX_HISTORY=30

# ================================
# Docker Compose 전용 (사용 시)
# ================================
DB_ROOT_PASSWORD=rootpassword
DB_NAME=locc
